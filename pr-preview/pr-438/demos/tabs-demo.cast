[0.000000, "o", "\u001b[2J\u001b[1;1H\u001b[0;36m╭─────────────────────────────────────────────────\u001b[0;36;1m TamboUI \u001b[0;36mTabs Demo ──────────────────────────────────────────────────╮\u001b[2;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[3;1H╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[4;1H\u001b[0;32m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[5;1H│\u001b[0;33;1m \u001b[0;33;1;2m1\u001b[0;33;1m:Home \u001b[0;97m │  \u001b[0;97;2m2\u001b[0;97m:Settings  │  \u001b[0;97;2m3\u001b[0;97m:Profile  │  \u001b[0;97;2m4\u001b[0;97m:Help                                                                       \u001b[0;32m│\u001b[6;1H╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[7;1H\u001b[0;36m╭ \u001b[0;36;1mHome\u001b[0;36m ────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[8;1H│\u001b[0mWelcome to TamboUI!                                                                                                   \u001b[0;36m│\u001b[9;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[10;1H│\u001b[0mTamboUI is a pure Java port of ratatui, the Rust library for                                                          \u001b[0;36m│\u001b[11;1H│\u001b[0mbuilding terminal user interfaces.                                                                                    \u001b[0;36m│\u001b[12;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[13;1H│\u001b[0mFeatures:                                                                                                             \u001b[0;36m│\u001b[14;1H│\u001b[0m  - Pure Java implementation (no native dependencies)                                                                 \u001b[0;36m│\u001b[15;1H│\u001b[0m  - Modern Java 21+ features (records, sealed classes, pattern matching)                                              \u001b[0;36m│\u001b[16;1H│\u001b[0m  - JLine backend for cross-platform terminal support                                                                 \u001b[0;36m│\u001b[17;1H│\u001b[0m  - GraalVM native image compatible                                                                                   \u001b[0;36m│\u001b[18;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[19;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[20;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[21;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[22;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[23;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[24;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[25;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[26;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[27;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[28;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[29;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[30;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[31;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[32;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[33;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[34;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[35;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[36;1H│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[37;1H╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[38;1H\u001b[0;90m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39;1H│\u001b[0;33;1m Tab/→\u001b[0;2m Next  \u001b[0;33;1m←/Shift+Tab\u001b[0;2m Prev  \u001b[0;33;1m1-4\u001b[0;2m Jump  \u001b[0;33;1mq\u001b[0;2m Quit\u001b[0m                                                                       \u001b[0;90m│\u001b[40;1H╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
