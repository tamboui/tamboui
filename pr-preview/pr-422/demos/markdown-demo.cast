────────────────────────────────────────────────\u001b[0m│\u001b[14;1H│                                                                                                                      │\u001b[15;1H│Bullet lists:                                                                                                         │\u001b[16;1H│                                                                                                                      │\u001b[17;1H│\u001b[0;36m• \u001b[0mbuffers are diffed before flush                                                                                     │\u001b[18;1H│\u001b[0;36m• \u001b[0mwidgets render to a single \u001b[0;37;2mBuffer\u001b[0m                                                                                   │\u001b[19;1H│\u001b[0;36m• \u001b[0mthe toolkit is a thin DSL on top                                                                                    │\u001b[20;1H│                                                                                                                      │\u001b[21;1H│Ordered lists:                                                                                                        │\u001b[22;1H│                                                                                                                      │\u001b[23;1H│\u001b[0;36m1. \u001b[0mparse markdown                                                                                                     │\u001b[24;1H│\u001b[0;36m2. \u001b[0mlayout into chunks                                                                                                 │\u001b[25;1H│\u001b[0;36m3. \u001b[0mrender to the buffer                                                                                               │\u001b[26;1H│                                                                                                                      │\u001b[27;1H│GFM task lists:                                                                                                       │\u001b[28;1H│                                                                                                                      │\u001b[29;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mparse CommonMark                                                                                                │\u001b[30;1H│\u001b[0;36m• \u001b[0;32m[x] \u001b[0mhandle GFM tables                                                                                               │\u001b[31;1H│\u001b[0;36m• \u001b[0;37m[ ] \u001b[0madd toolkit DSL element                                                                                         │\u001b[32;1H│                                                                                                                      │\u001b[33;1H│\u001b[0;33;1mTables\u001b[0m                                                                                                                │\u001b[34;1H│\u001b[0;37m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m│\u001b[35;1H│                                                                                                                      │\u001b[36;1H│\u001b[0;1mWidget\u001b[0m                                  \u001b[0;1mStateful\u001b[0m                                \u001b[0;1mModule\u001b[0m                                │\u001b[37;1H│Paragraph                               no                                      tamboui-widgets                       │\u001b[38;1H│Table                                   yes                                     tamboui-widgets                       │\u001b[39;1H│Markdown                                no                                      tamboui-markdown                      │\u001b[40;1H╰ j/k scroll · s stream · q quit ──────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m"]
